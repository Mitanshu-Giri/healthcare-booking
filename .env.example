# Copy these into your IDE run configuration (IntelliJ: Run > Edit Configurations > Environment variables)
# or export them in your terminal. Never commit real values.

DB_HOST=localhost
DB_PORT=3306
DB_NAME=healthcare_db
DB_USERNAME=root
DB_PASSWORD=Mit@0401

# At least 32 characters. Generate one with: openssl rand -base64 48
JWT_SECRET="MyHealthcareProjectSecretKey2026Secure0401"
JWT_EXPIRATION_MINUTES=30

# Frontend dev server origin(s), comma separated
CORS_ALLOWED_ORIGINS=http://localhost:5173

# Demo doctors (6 active + 1 deactivated) are created on startup so the app has data.
# Set SEED_DEMO_DATA=false in production. All demo doctors log in with DEMO_DOCTOR_PASSWORD.
# Demo emails look like priya.sharma@demo.healthcare.example (see DemoDataInitializer.java).
SEED_DEMO_DATA=true
DEMO_DOCTOR_PASSWORD=Doctor@123

# Optional: creates the first admin account on startup
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin@12345

#doctor_priya_details
{
  "email": "priya.sharma@demo.healthcare.example",
  "password": "Doctor@123"
}
